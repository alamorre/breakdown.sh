    "pretest:coverage": "pnpm --filter @breakdown-sh/core build && pnpm run build",
    "test:coverage": "vitest run src/index.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@breakdown-sh/core": "workspace:1.0.0-beta.1"
  }
}
