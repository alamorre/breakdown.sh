{
  "name": "@breakdown-sh/cli",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "bin": {
    "breakdown": "./dist/index.js"
  },
  "files": [
    "dist",
    "package.json"
