{
  "name": "@breakdown-sh/cli",
  "version": "1.0.1",
  "description": "Filesystem-first command-line interface for Breakdown Local.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alamorre/breakdown.sh.git",
    "directory": "packages/breakdown-cli"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "exports": {},
  "bin": {
    "breakdown": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "npm-shrinkwrap.json",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/generate-protocol-validator.mjs",
    "pretest": "pnpm --filter @breakdown-sh/core build && pnpm run build",
    "test": "vitest run src/index.test.ts",
    "pretest:coverage": "pnpm --filter @breakdown-sh/core build && pnpm run build",
    "test:coverage": "vitest run src/index.test.ts",
    "pretypecheck": "pnpm --filter @breakdown-sh/core build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@breakdown-sh/core": "workspace:1.0.1"
  },
  "devDependencies": {
    "ajv": "8.18.0"
  }
}
