{
  "name": "@breakdown-sh/core",
  "version": "1.0.0-beta.1",
  "description": "Deterministic local workflow contracts and storage for Breakdown Local.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alamorre/breakdown.sh.git",
    "directory": "packages/breakdown-core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage --coverage.include='src/{canonical-json,index,run-inspection,unicode}.ts' --coverage.thresholds.lines=80",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
