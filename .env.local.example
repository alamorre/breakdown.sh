# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Drive integration
# The checked local OAuth client is approved for localhost:3000 only.
# Add production origins and redirect URIs in Google Cloud before deploying.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# 32 random bytes as base64, e.g. `openssl rand -base64 32`
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=
# Google Cloud project number, used by Google Picker as the app ID.
NEXT_PUBLIC_GOOGLE_DRIVE_APP_ID=
