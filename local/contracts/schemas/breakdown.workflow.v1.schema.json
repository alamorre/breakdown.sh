{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "breakdown.workflow.v1",
  "$comment": "release_version=1.0.0",
  "title": "Breakdown Workflow Definition v1",
  "description": "The machine shape for a Breakdown Workflow Definition. YAML profile, path, reference, graph, and deterministic-ordering rules are normative but require validation beyond JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "nodes"],
  "properties": {
    "schema_version": {
      "const": "breakdown.workflow.v1"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/workflow-input"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "workflow-input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "default": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input-binding-source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_input"],
          "properties": {
            "workflow_input": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node"],
          "properties": {
            "node": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    },
    "data-contract-type": {
      "enum": ["array", "boolean", "integer", "null", "number", "object", "string"]
    },
    "data-contract-schema-node": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/data-contract-schema"
        }
      ]
    },
    "data-contract-schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "oneOf": [
            {
              "$ref": "#/$defs/data-contract-type"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/data-contract-type"
              }
            }
          ]
        },
        "enum": {
          "type": "array"
        },
        "const": {},
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/data-contract-schema-node"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "$ref": "#/$defs/data-contract-schema-node"
        },
        "items": {
          "$ref": "#/$defs/data-contract-schema-node"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "exclusiveMinimum": {
          "type": "number"
        },
        "exclusiveMaximum": {
          "type": "number"
        }
      }
    },
    "extension-namespace": {
      "type": "string",
      "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/extension-namespace"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "prompt"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/input-binding-source"
          }
        },
        "data_contract": {
          "$ref": "#/$defs/data-contract-schema"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    }
  }
}
