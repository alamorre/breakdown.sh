{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breakdown.sh/contracts/schemas/breakdown.workflow.v1.schema.json",
  "title": "Breakdown Workflow Definition v1",
  "description": "The machine shape for a Breakdown Workflow Definition. YAML profile, path, reference, graph, and deterministic-ordering rules are normative but require validation beyond JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "nodes"],
  "properties": {
    "schema_version": {
      "const": "breakdown.workflow.v1"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/workflow-input"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "workflow-input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "default": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input-binding-source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_input"],
          "properties": {
            "workflow_input": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node"],
          "properties": {
            "node": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "prompt"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/input-binding-source"
          }
        },
        "data_contract": {
          "type": "object"
        },
        "extensions": {
          "type": "object"
        }
      }
    }
  }
}
