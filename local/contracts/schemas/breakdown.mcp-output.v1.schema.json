{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "breakdown.mcp-output.v1",
  "$comment": "release_version=1.0.1",
  "title": "Breakdown MCP Tool Output v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "release_version",
        "supported_operation_schemas",
        "operation",
        "ok",
        "data",
        "error"
      ],
      "properties": {
        "schema_version": { "const": "breakdown.mcp-output.v1" },
        "release_version": { "const": "1.0.1" },
        "supported_operation_schemas": {
          "const": ["breakdown.operation-request.v1"]
        },
        "operation": { "$ref": "#/$defs/operation" },
        "ok": { "const": true },
        "data": { "$ref": "breakdown.operation-value.v1" },
        "error": { "type": "null" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "release_version",
        "supported_operation_schemas",
        "operation",
        "ok",
        "data",
        "error"
      ],
      "properties": {
        "schema_version": { "const": "breakdown.mcp-output.v1" },
        "release_version": { "const": "1.0.1" },
        "supported_operation_schemas": {
          "const": ["breakdown.operation-request.v1"]
        },
        "operation": { "$ref": "#/$defs/operation" },
        "ok": { "const": false },
        "data": { "type": "null" },
        "error": { "$ref": "#/$defs/error" }
      }
    }
  ],
  "$defs": {
    "operation": {
      "enum": [
        "validate_workflow",
        "create_run",
        "inspect_run",
        "prepare_work",
        "read_work_input",
        "submit_candidate"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message", "diagnostics"],
      "properties": {
        "kind": {
          "enum": [
            "invalid",
            "conflict",
            "unsupported",
            "cancelled",
            "resource_limit",
            "io",
            "internal"
          ]
        },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": { "type": "string" },
        "path": { "type": "string" },
        "message": { "type": "string" },
        "file": { "type": "string" }
      }
    }
  }
}
