{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "breakdown.work-packet.v1",
  "title": "Breakdown Work Packet v1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "intent": { "const": "refresh" }
        }
      },
      "then": {
        "required": ["refresh_base"],
        "properties": {
          "submission": { "required": ["refresh_base"] }
        }
      },
      "else": {
        "not": { "required": ["refresh_base"] },
        "properties": {
          "submission": { "not": { "required": ["refresh_base"] } }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "run_id",
    "intent",
    "prepared_at",
    "node",
    "inputs",
    "task",
    "policy",
    "result",
    "limits",
    "expected_attempt",
    "context_sha256",
    "submission"
  ],
  "properties": {
    "schema_version": { "const": "breakdown.work-packet.v1" },
    "run_id": { "type": "string" },
    "intent": { "enum": ["resume", "refresh"] },
    "prepared_at": { "type": "string", "format": "date-time" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "prompt"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "prompt": { "type": "string" },
        "inputs": { "type": "object", "additionalProperties": { "type": "object" } },
        "data_contract": { "type": "object" }
      }
    },
    "inputs": { "type": "object", "additionalProperties": { "type": "object" } },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions"],
      "properties": { "instructions": { "type": "string" } }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "inputs"],
      "properties": { "core": { "type": "string" }, "inputs": { "type": "string" } }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markdown", "json", "data_contract"],
      "properties": {
        "markdown": { "const": "required" },
        "json": { "enum": ["required", "forbidden"] },
        "data_contract": { "type": ["object", "null"] }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_packet_bytes", "candidate_markdown_bytes", "candidate_json_bytes"],
      "properties": {
        "work_packet_bytes": { "type": "integer" },
        "candidate_markdown_bytes": { "type": "integer" },
        "candidate_json_bytes": { "type": "integer" }
      }
    },
    "expected_attempt": { "type": "integer", "minimum": 1 },
    "context_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "refresh_base": { "$ref": "#/$defs/selectedResult" },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "node_id",
        "intent",
        "prepared_at",
        "expected_attempt",
        "context_sha256"
      ],
      "properties": {
        "run_id": { "type": "string" },
        "node_id": { "type": "string" },
        "intent": { "enum": ["resume", "refresh"] },
        "prepared_at": { "type": "string", "format": "date-time" },
        "expected_attempt": { "type": "integer", "minimum": 1 },
        "context_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "refresh_base": { "$ref": "#/$defs/selectedResult" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resultFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "selectedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "attempt", "markdown"],
      "properties": {
        "node_id": { "$ref": "#/$defs/identifier" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "markdown": { "$ref": "#/$defs/resultFile" },
        "json": { "$ref": "#/$defs/resultFile" }
      }
    }
  }
}
