{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["local/**/*.test.ts", "scripts/**/*.test.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "local/vendor"]
}
