{
  "name": "breakdown.sh",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "next dev",
    "dev:secrets": "doppler run -- pnpm dev",
    "build": "next build",
    "build:secrets": "doppler run -- sh -c 'pnpm secrets:check && pnpm build'",
    "start": "next start",
    "start:secrets": "doppler run -- pnpm start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && pnpm --filter @breakdown-sh/core typecheck && pnpm --filter @breakdown-sh/cli typecheck && pnpm --filter @breakdown-sh/mcp typecheck",
    "test": "vitest run && pnpm --filter @breakdown-sh/core test && pnpm --filter @breakdown-sh/cli test && pnpm --filter @breakdown-sh/mcp test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && pnpm --filter @breakdown-sh/core test:coverage && pnpm --filter @breakdown-sh/cli test:coverage && pnpm --filter @breakdown-sh/mcp test:coverage",
    "audit:high": "pnpm audit --audit-level high",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "ci:secrets": "doppler run -- sh -c 'pnpm secrets:check && pnpm ci'",
    "secrets:check": "node scripts/check-env.mjs",
    "plugin:version": "node scripts/plugin-version.mjs",
    "plugin:version:check": "node scripts/plugin-version-guard.mjs",
    "plugin:release:compare": "node scripts/plugin-release-compare.mjs",
    "plugin:release:smoke": "node scripts/plugin-release-smoke.mjs",
    "plugin:release:command": "node scripts/plugin-release-command.mjs",
    "headless:token": "node scripts/create-integration-token.mjs",
    "headless:smoke": "node scripts/headless-external-run-smoke.mjs",
    "headless:verify": "node scripts/headless-interface-verify.mjs",
    "local:docs:generate": "node scripts/generate-local-documentation.mjs --write",
    "local:docs:check": "node scripts/generate-local-documentation.mjs --check",
    "local:contracts:archive": "node scripts/generate-local-documentation.mjs --archive",
    "local:release:build": "node scripts/build-local-release.mjs",
    "local:release:inspect": "node scripts/inspect-local-release.mjs",
    "local:release:qualify": "node scripts/qualify-local-release.mjs",
    "local:release:index-platform": "node scripts/index-platform-evidence.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@base-ui/react": "^1.3.0",
    "@clerk/nextjs": "^7.4.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@supabase/supabase-js": "^2.99.3",
    "@tailwindcss/typography": "^0.5.19",
    "@xyflow/react": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.11.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
