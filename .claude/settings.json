{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/adamlamorre/Work/Adam/breakdown.sh && make format && make check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/adamlamorre/Work/Adam/breakdown.sh && npx prettier --write $CLAUDE_FILE_PATH"
          }
        ]
      }
    ]
  }
}
